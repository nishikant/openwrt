#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

SERVICE="custom-package-install"
LOG="/root/custom-package-install.log"
STEP3="/root/.resize-step3"

log() {
    echo "[$(date '+%F %T')] $*" | tee -a "$LOG"
}

start_service() {
    log "Running custom-package-install"

    if [ -f "$STEP3" ]; then
        log "Stage3 complete. Installing packages."

        # Disable this service so it doesn't run again
        /etc/init.d/"$SERVICE" disable

        # Update package index
        log "Running apk update..."
        if ! apk update >> "$LOG" 2>&1; then
            log "apk update failed"
            return 1
        fi

        # Install minidlna
        log "Installing luci-app-minidlna..."
        if ! apk add luci-app-minidlna >> "$LOG" 2>&1; then
            log "Failed to install luci-app-minidlna"
            return 1
        fi

        # Add more packages if needed
        # apk add package1 package2

        sync
        log "Package installation completed."

    else
        log "custom-package-install failed: $STEP3 not found"
        /etc/init.d/"$SERVICE" disable
        return 1
    fi
}
